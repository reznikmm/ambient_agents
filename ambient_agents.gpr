with "config/ambient_agents_config.gpr";
project Ambient_Agents is

   for Source_Dirs use ("source/", "config/");
   for Object_Dir use ".obj/" & Ambient_Agents_Config.Build_Profile;
   for Create_Missing_Dirs use "True";

   for Exec_Dir use "bin";
   for Main use ("ambient_agents-run.adb");

   package Compiler is
      for Default_Switches ("Ada") use Ambient_Agents_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Ambient_Agents;
