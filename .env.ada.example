# Optional, sourced by ada/run.sh and ada/workshop.sh. Do not commit .env.ada.
PORT=4100
INSTANCE=ambient-ada
WORKSHOP_STEP=8
STATE_PATH=.data/agent.json
MEMORY_DIR=memory
SIM_SPEED=1
WORKER_MODE=sim
GATE_MODE=rules

# Any OpenAI-compatible Chat Completions server, including llama.cpp.
CHAT_COMPLETIONS_URL=http://127.0.0.1:8080/v1/chat/completions
CHAT_MODEL=local-model
GATE_MODEL=local-model
WORKER_MODEL=local-model
OPENAI_API_KEY=
# Alternatively set OPENROUTER_API_KEY or AI_GATEWAY_API_KEY and omit
# CHAT_COMPLETIONS_URL to select that provider's endpoint.

# ACP v2 adapter executable. Use a wrapper script for additional arguments.
# For Claude: export CLAUDE_AGENT_ACP_PROTOCOL=v2 in that wrapper.
# The sibling acp/demos/claude and acp/demos/codex document adapter installation.
ACP_AGENT=claude-agent-acp

GITHUB_REPO=
GITHUB_SOURCE=poll
AGENT_LOGIN=ambient-agent
GITHUB_WEBHOOK_SECRET=
SLACK_WEBHOOK_URL=
CHAT_CAN_COMMENT=0

# Optional probabilistic gate. Never needed for evaluations.
DECISION_PROVIDER=jev
DECISION_THRESHOLD=0.6
TYPESAFE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
